# CrimeLink backend environment template
# PostgreSQL is the primary relational database.
DATABASE_URL=postgresql+psycopg://crime_analysis:crime_analysis@localhost:5432/crime_analysis

# Neo4j graph database
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password

# NVIDIA Nemotron (backend only)
NVIDIA_API_KEY=nvapi-your_actual_api_key_here
# Primary model: fast, responsive reasoning model tested in Phase 2
NVIDIA_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
# Fallback model: automatically used if the primary model fails or times out
NVIDIA_FALLBACK_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_TTFT_TIMEOUT_SECONDS=15.0
NVIDIA_INTER_TOKEN_TIMEOUT_SECONDS=15.0
