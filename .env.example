# Crime Analysis — environment template.
#
# Copy this file to .env and fill in real values.
# Never commit .env or expose NVIDIA_API_KEY to the frontend.

NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password

# NVIDIA Nemotron (backend only)
NVIDIA_API_KEY=your_nvidia_api_key
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_TEMPERATURE=0.3
NVIDIA_TOP_P=0.95
NVIDIA_MAX_TOKENS=2048
# Chat is streamed and lightweight by default.
NVIDIA_ENABLE_THINKING=0
NVIDIA_REASONING_BUDGET=1024
NVIDIA_TIMEOUT_SECONDS=90

# Application environment
APP_ENV=development

# Optional application settings
# In production, set APP_ENV=production and provide a strong random JWT_SECRET (32+ characters).
# JWT_SECRET=change-me-to-a-long-random-string-in-production
# Comma-separated frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Login protection: 5 failed attempts per IP/account within 15 minutes.
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
# JWT_EXPIRE_MINUTES=720
# TESSERACT_CMD=tesseract
# MAX_UPLOAD_MB=25
# AUTO_SEED=1
