# Crime Analysis — environment template.
#
# Copy this file to `.env` (repo root, or `backend/`) and fill in real values.
# The `.env` file is git-ignored on purpose: it holds secrets and must NEVER
# be committed. Real environment variables always take precedence over
# values defined here. See docs/ENVIRONMENT.md for full documentation.

# ---------------------------------------------------------------- SQLite ---
# System of record (unchanged). Only uncomment to relocate the database.
# DATABASE_URL=sqlite:///./crime_analysis.db

# ------------------------------------------------------------------- Auth ---
# JWT_SECRET=change-me-to-a-long-random-string-in-production
# JWT_EXPIRE_MINUTES=720

# --------------------------------------------------------- Remote Neo4j ---
# Connection details of the REMOTE Neo4j instance (e.g. Neo4j Aura).
# Use the exact URI provided by your Neo4j provider — neo4j+s:// is the
# encrypted (TLS) transport; do not downgrade it to a plain scheme.
# All three variables are required to enable the connection; leaving them
# empty keeps the app running on SQLite with the in-process graph projection.
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password

# ---------------------------------------------------- Pipeline / uploads ---
# TESSERACT_CMD=tesseract
# MAX_UPLOAD_MB=25
# AUTO_SEED=1
