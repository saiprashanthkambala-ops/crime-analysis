# Crime Analysis — environment template.
#
# Copy this file to .env (repo root, or backend/) and fill in real values.
# The .env file is git-ignored and must never be committed.

# ---------------------------------------------------------------- SQLite ---
# DATABASE_URL=sqlite:///./crime_analysis.db

# ------------------------------------------------------------------- Auth ---
# JWT_SECRET=change-me-to-a-long-random-string-in-production
# JWT_EXPIRE_MINUTES=720

# --------------------------------------------------------- Remote Neo4j ---
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password

# --------------------------------------------------- NVIDIA Analysis ---
# Backend-only secret. Never put this in frontend code.
NVIDIA_API_KEY=your_nvidia_api_key
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_TEMPERATURE=1
NVIDIA_TOP_P=0.95
NVIDIA_MAX_TOKENS=16384
NVIDIA_ENABLE_THINKING=1
NVIDIA_REASONING_BUDGET=16384

# ---------------------------------------------------- Pipeline / uploads ---
# TESSERACT_CMD=tesseract
# MAX_UPLOAD_MB=25
# AUTO_SEED=1
