# Crime Analysis environment template
# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL primary relational database
DATABASE_URL=postgresql+psycopg://crime_analysis:crime_analysis@localhost:5432/crime_analysis

# Neo4j graph database
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password

# NVIDIA Nemotron (backend only)
NVIDIA_API_KEY=your_nvidia_api_key
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_TEMPERATURE=0.3
NVIDIA_TOP_P=0.95
NVIDIA_MAX_TOKENS=2048
NVIDIA_ENABLE_THINKING=0
NVIDIA_REASONING_BUDGET=1024
NVIDIA_TIMEOUT_SECONDS=90

# Application
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
JWT_EXPIRE_MINUTES=720
TESSERACT_CMD=tesseract
MAX_UPLOAD_MB=25
AUTO_SEED=1
