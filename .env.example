# Crime Analysis — environment template.
#
# Copy this file to .env and fill in real values.
# Never commit .env or expose NVIDIA_API_KEY to the frontend.

NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password

# NVIDIA Nemotron (backend only)
NVIDIA_API_KEY=your_nvidia_api_key
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_TEMPERATURE=0.3
NVIDIA_TOP_P=0.95
NVIDIA_MAX_TOKENS=2048
# Disabled initially so the Analysis page returns promptly.
NVIDIA_ENABLE_THINKING=0
NVIDIA_REASONING_BUDGET=1024
NVIDIA_TIMEOUT_SECONDS=45

# Optional application settings
# JWT_SECRET=change-me-to-a-long-random-string-in-production
# JWT_EXPIRE_MINUTES=720
# TESSERACT_CMD=tesseract
# MAX_UPLOAD_MB=25
# AUTO_SEED=1
